{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "api": {
            "root": "apps/api",
            "framework": "hono",
            "entrypoint": "vercel-entry.mjs"
        },
        "web": {
            "root": "apps/web",
            "framework": "nextjs"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "api"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "web"
            }
        }
    ]
}